{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!**/dist", "!**/coverage", "!pnpm-lock.yaml"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "noDefaultExport": "error",
        "noNonNullAssertion": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": { "filenameCases": ["kebab-case"] }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/contexts/*/domain/**", "src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "Domain code must not touch the browser.",
                  "document": "Domain code must not touch the DOM.",
                  "navigator": "Domain code must not touch the browser.",
                  "localStorage": "Persist through a port implemented in infrastructure.",
                  "requestAnimationFrame": "The loop lives in src/game.",
                  "performance": "Use the Clock port from src/shared."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["vite.config.ts", "vitest.config.ts", "vitest.montage.config.ts"],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
